{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "entrypoint": "src/app.ts"
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite",
      "buildCommand": "PORT=3001 BASE_PATH=/mockups/ pnpm run build",
      "outputDirectory": "dist"
    },
    "souvik-portfolio": {
      "root": "artifacts/souvik-portfolio",
      "framework": "vite",
      "buildCommand": "PORT=3000 BASE_PATH=/ pnpm run build",
      "outputDirectory": "dist/public"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/mockups",
      "destination": {
        "service": "mockup-sandbox",
        "path": "/"
      }
    },
    {
      "source": "/mockups/:path*",
      "destination": {
        "service": "mockup-sandbox",
        "path": "/:path*"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "souvik-portfolio"
      }
    }
  ]
}
